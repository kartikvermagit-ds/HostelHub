# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:3000

# Supabase Credentials (Required)
# Retrieve from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage Bucket Names
SUPABASE_STORAGE_BUCKET=hostelhub-resources

# File Size Limits (in Bytes)
MAX_PDF_SIZE=20971520      # 20 MB
MAX_IMAGE_SIZE=10485760    # 10 MB
MAX_VIDEO_SIZE=104857600   # 100 MB

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=300         # Max requests per window
